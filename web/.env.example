# Copy to .env.local and fill in. Vite reads it on `npm run dev`.
VITE_NEAR_NETWORK=testnet
VITE_CONTRACT_ID=
# Required for a production build. Development falls back to http://localhost:8787.
VITE_KEEPER_URL=http://localhost:8787
# Must match the keeper's AUTH_RECIPIENT. The app refuses to sign for any other.
# VITE_AUTH_RECIPIENT=nearkat.xyz
# Optional custom RPC endpoint for testnet or mainnet:
# VITE_NEAR_RPC_URL=

# Only for a local sandbox node:
# VITE_NEAR_NETWORK=sandbox
# VITE_NEAR_RPC_URL=http://127.0.0.1:3030

# Development server only: sign with a fixed key instead of a browser wallet.
# NEVER set these when building. Vite copies VITE_ values into the bundle, so the
# key would be public; `npm run build` refuses to run while the key is set.
# VITE_DEV_WALLET_ID=
# VITE_DEV_WALLET_KEY=

# The launchpad contract. Leave unset to hide the launchpad.
# VITE_FACTORY_ID=
