# Copy to .env and fill in. `npm run dev` loads .env automatically.
NEAR_NETWORK=testnet
CONTRACT_ID=
KEEPER_ACCOUNT_ID=
# 64 hex characters. Generate with: openssl rand -hex 32
# Every kat's encryption key and the keeper's NEAR key derive from this.
# Losing it makes all stored contexts unreadable.
KEEPER_ROOT_SECRET=
NEAR_AI_API_KEY=
# Optional, with their defaults:
# NEAR_RPC_URL=            (required when NEAR_NETWORK=sandbox)
# NEAR_AI_MODEL=z-ai/glm-5.3-flash      (must be a canonical id from /v1/models, not an alias)
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# STORE_DIR=./data/contexts
# METER_JOURNAL=./data/meter.json
# NEAR_AI_MAX_TOKENS=2048              (includes the model's reasoning; too low gives no reply)
# PORT=8787
# AUTH_RECIPIENT=nearkat.xyz
# WEB_ORIGIN=http://localhost:3000      (comma-separated for several)
# CHAT_PRICE_YOCTO=2000000000000000000000
# SAVE_PRICE_YOCTO=50000000000000000000000
#
# Inside a Phala Cloud (dstack) app. Keys then come from dstack's KMS and
# KEEPER_ROOT_SECRET must be left unset. A collection that names a Phala app
# is only served by a keeper running as that app.
# KEEPER_MODE=phala
# DSTACK_ENDPOINT=                      (default: the guest agent's unix socket; a URL reaches the simulator)
#
# More collections. The keeper serves each one whose contract names KEEPER_ACCOUNT_ID
# as its keeper; the others are listed at GET /collections with the reason.
# CONTRACT_IDS=                         (comma-separated contract ids)
# LAUNCHPAD_ID=                         (serve collections launched there too)
# WITHDRAW_MIN_YOCTO=1000000000000000000000000   (withdraw inference earnings from 1 NEAR)
#
# Durable storage for contexts on any S3-compatible service (AWS, R2, MinIO, B2).
# Contexts are encrypted before they leave the keeper. The disk then only caches them.
# S3_BUCKET=
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=nearkat/
# S3_VIRTUAL_HOST=false                 (true for <bucket>.<host> addressing)
