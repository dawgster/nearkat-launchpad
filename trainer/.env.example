# Copy to .env and fill in. `npm run dev` loads .env automatically.
NEAR_NETWORK=testnet
TRAINER_ACCOUNT_ID=
# local mode only: 64 hex characters (openssl rand -hex 32). Must be unset in phala mode.
# The trainer's NEAR key derives from it: add that key to the account as full-access.
TRAINER_ROOT_SECRET=
# Optional, with their defaults:
# TRAINER_MODE=local                    (phala: keys come from dstack, the app registers itself)
# TRAINER_APP_ID=local-trainer          (local mode only; refused in phala mode, which reads it from dstack)
# TRAINER_LABEL=Hotdog CNN
# NEAR_RPC_URL=                         (required when NEAR_NETWORK=sandbox)
# ARCHIVAL_RPC_URL=https://archival-rpc.<network>.fastnear.com
# FASTFS_GATEWAY=                       (mainnet default: https://{uploader}.fastfs.io)
# HELDOUT_DIR=./data/heldout            (<dir>/<class>/*.jpg)
# PORT=8790
# WEB_ORIGINS=http://localhost:3000     (comma-separated for several)
# AUTH_RECIPIENT=nearkat.xyz
# TRUST_PROXY=false                     (true behind a reverse proxy)
# DSTACK_ENDPOINT=                      (phala: default is the guest agent's unix socket)
# TRAINER_PYTHON=                       (interpreter for py/train.py; default: uv run)
